{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/master-video-system/style-pack.schema.json",
  "title": "User-approved video style pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "typography", "palette", "surfaces", "lighting", "motion", "sound", "hard_constraints"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "status": { "enum": ["awaiting_user_selection", "draft", "user_approved", "deprecated"] },
    "reference_paths": { "type": "array", "items": { "type": "string" } },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_serif", "text_serif", "caption_serif", "tabular_serif", "font_files_verified"],
      "properties": {
        "display_serif": { "$ref": "#/$defs/fontRole" },
        "text_serif": { "$ref": "#/$defs/fontRole" },
        "caption_serif": { "$ref": "#/$defs/fontRole" },
        "tabular_serif": { "$ref": "#/$defs/fontRole" },
        "font_files_verified": { "type": "boolean" },
        "font_specimen_path": { "type": ["string", "null"] },
        "max_families": { "const": 2 }
      }
    },
    "palette": {
      "type": "object",
      "required": ["background", "foreground", "muted", "accent_primary"],
      "properties": {
        "background": { "type": "string" },
        "foreground": { "type": "string" },
        "muted": { "type": "string" },
        "accent_primary": { "type": "string" },
        "accent_secondary": { "type": ["string", "null"] }
      }
    },
    "surfaces": {
      "type": "object",
      "required": ["base", "texture_strength", "grain_strength"],
      "properties": {
        "base": { "enum": ["clean", "paper", "stone", "fabric", "film", "restrained_glass"] },
        "texture_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "grain_strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "lighting": {
      "type": "object",
      "required": ["contrast_mode", "highlight_behavior", "vignette_strength"],
      "properties": {
        "highlight_behavior": { "enum": ["none", "soft_local_pool", "edge_atmosphere", "subject_key", "evidence_spotlight"] },
        "vignette_strength": { "type": "number", "minimum": 0, "maximum": 0.5 }
      }
    },
    "motion": {
      "type": "object",
      "required": ["easing_character", "blur_character"],
      "properties": {
        "easing_character": { "enum": ["precise", "editorial", "cinematic", "tactile"] },
        "blur_character": { "enum": ["none", "subtle_focus", "velocity_only"] }
      }
    },
    "sound": { "type": "object", "required": ["palette_id"], "properties": { "palette_id": { "type": ["string", "null"] } } },
    "hard_constraints": {
      "type": "object",
      "required": ["serif_only", "decorative_top_bottom_notes", "diagonal_or_crossing_line_fields", "pseudo_wayfinding_counters", "small_accent_kicker_with_detached_rule"],
      "properties": {
        "serif_only": { "const": true },
        "decorative_top_bottom_notes": { "const": false },
        "diagonal_or_crossing_line_fields": { "const": false },
        "pseudo_wayfinding_counters": { "const": false },
        "small_accent_kicker_with_detached_rule": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "user_approved" } }, "required": ["status"] },
      "then": {
        "properties": {
          "typography": {
            "required": ["font_specimen_path"],
            "properties": {
              "font_files_verified": { "const": true },
              "font_specimen_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fontRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "classification", "fallback", "file_paths", "license"],
      "properties": {
        "family": {
          "type": ["string", "null"],
          "not": { "enum": ["Inter", "Arial", "Helvetica", "Roboto", "Barlow", "system-ui", "sans-serif", "monospace"] }
        },
        "classification": { "const": "serif" },
        "fallback": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "not": { "enum": ["Inter", "Arial", "Helvetica", "Roboto", "Barlow", "system-ui", "sans-serif", "monospace"] }
          },
          "contains": { "const": "serif" }
        },
        "file_paths": { "type": "array", "items": { "type": "string" } },
        "license": { "type": ["string", "null"] }
      }
    }
  }
}
